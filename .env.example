# Copy this file to .env and replace all placeholders.
# Never commit real secrets.

# Django signing key
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_new_random_key

# Django security configuration
DJANGO_SECURE_DEMO=true
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# PostgreSQL configuration
POSTGRES_DB=CHANGE_ME_database_name
POSTGRES_USER=CHANGE_ME_database_user
POSTGRES_PASSWORD=CHANGE_ME_new_private_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# Local database SSL configuration
# For remote databases, use verify-full and configure a trusted CA.
POSTGRES_SSLMODE=disable
# POSTGRES_SSLROOTCERT=C:/private/postgres-root.crt