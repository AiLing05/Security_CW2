# Django signing key (required).
# Generate a unique key locally; never commit real secrets.
DJANGO_SECRET_KEY=replace-with-your-own-generated-secret

# Django configuration
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL password (required in production)
DB_PASSWORD=

# Set True only for an HTTPS-configured production deployment
DJANGO_PRODUCTION=False
