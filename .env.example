# Copy to .env and replace ALL placeholders. Never commit .env.
# Generate a key: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_new_random_key
DJANGO_SECURE_DEMO=true
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=CHANGE_ME_database_name
POSTGRES_USER=CHANGE_ME_database_user
POSTGRES_PASSWORD=CHANGE_ME_new_private_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Unencrypted loopback DB traffic is an explicit local-demo exception.
# For remote databases use verify-full and set the trusted CA file below.
POSTGRES_SSLMODE=disable
# POSTGRES_SSLROOTCERT=C:/private/postgres-root.crt
